{
  "name": "noteconnection",
  "version": "1.3.0",
  "description": "Hierarchical Knowledge Graph Visualization System",
  "main": "dist/src/electron/main.js",
  "bin": {
    "noteconnection": "dist/src/server.js"
  },
  "scripts": {
    "start": "node --max-old-space-size=12288 -r ts-node/register src/server.ts",
    "start:prod": "node dist/src/server.js",
    "tauri": "tauri",
    "tauri:dev": "npm run build && npm run build:sidecar && npx kill-port 3000 & node dist/src/server.js & npx tauri dev",
    "tauri:dev:mini": "npm run build:mini && npm run build:sidecar && npx kill-port 3000 & node dist/src/server.js & npx tauri dev",
    "tauri:build": "npm run build && npm run build:sidecar && npx tauri build",
    "electron:dev": "npm run build && electron .",
    "electron:dev:mini": "npm run build:mini && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mini": "npm run build:mini && electron-builder",
    "build": "tsc && node scripts/copy-assets.js && node scripts/bundle_path_core.js",
    "build:mini": "tsc && node scripts/copy-assets.js --mini",
    "build:sidecar": "pkg dist/src/server.js --target node18-win-x64 --output src-tauri/bin/server-x86_64-pc-windows-msvc.exe",
    "pathmode:dev": "node -r ts-node/register src/server.ts --pathmode",
    "pathmode:test": "jest --testPathPatterns=Path",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "pkg": {
    "assets": [
      "dist/src/**/*",
      "data.js",
      "graph_data.json"
    ]
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "knowledge-graph",
    "visualization",
    "markdown",
    "dag",
    "hierarchical"
  ],
  "author": {
    "name": "Jacob",
    "email": "Jacob.hxx.cn@outlook.com",
    "url": "https://github.com/Jacobinwwey"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jacobinwwey/NoteConnection"
  },
  "homepage": "https://github.com/Jacobinwwey/NoteConnection#readme",
  "bugs": {
    "url": "https://github.com/Jacobinwwey/NoteConnection/issues"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "jest": "^30.2.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@types/d3-force": "^3.0.10",
    "@types/ws": "^8.18.1",
    "d3-force": "^3.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "tslib": "^2.8.1",
    "ws": "^8.19.0"
  }
}
