{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "**/.local/share/**/*",
          "**/.cache/**/*",
          "**/.config/**/*",
          "$CACHE/**",
          "$CONFIG/**",
          "$DATA/**",
          "$HOME/**"
        ]
      }
    },
    "windows": [
      {
        "title": "NoteConnection",
        "width": 1280,
        "height": 900
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "bin/server-x86_64-unknown-linux-gnu",
      "bin/godot-x86_64-unknown-linux-gnu",
      "bin/markdown-worker-x86_64-unknown-linux-gnu"
    ]
  }
}
