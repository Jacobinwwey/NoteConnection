{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteConnection",
  "version": "1.7.0",
  "identifier": "com.jacobinwwey.noteconnection",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/run-tauri-frontend-build.js",
    "frontendDist": "../dist/src/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NoteConnection",
        "width": 1280,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/server",
      "bin/godot",
      "bin/markdown-worker"
    ]
  }
}
