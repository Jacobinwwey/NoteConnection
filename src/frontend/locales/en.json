      "welcome": {
        "title": "Welcome to NoteConnection!",
        "content": "This tutorial will guide you through the key features. You can skip at any time or restart from the Help menu."
      },
      "kbSelection": {
        "title": "Knowledge Base Selection",
        "content": "Use the <strong>dropdown menu</strong> here to select which folder (or subfolder) you want to analyze. Choose <em>All Folders</em> to include everything."
      },
      "loadButton": {
        "title": "Load Your Graph",
        "content": "Once you've selected a source, click the <strong>Load</strong> button to process your notes. The system will analyze relationships and build your knowledge graph."
      },
      "analysis": {
        "title": "Analysis Interface",
        "content": "The <strong>Analysis Panel</strong> shows node statistics like degree centrality. Click any row to highlight that node in the graph. Perfect for identifying key concepts!"
      },
      "focusMode": {
        "title": "Focus Mode",
        "content": "<strong>Double-click any node</strong> to enter Focus Mode. This isolates the selected concept and its immediate connections. Use the sliders to adjust spacing. Double-click the background to exit."
      },
      "controls": {
        "title": "Navigation & Controls",
        "content": "Use <strong>mouse wheel</strong> to zoom, <strong>click and drag</strong> to pan. The settings panel (⚙️) lets you customize physics, rendering, and visual options. Try the <strong>Freeze Layout</strong> button (❄️) to stop node movement!"
      },
      "quickStart": {
        "title": "Quick Start Guide",
        "content": "That covers the basics! Next, you'll see the <strong>Quick Start Guide</strong> summarizing key actions. You can access it anytime from the <strong>Help menu</strong>. Happy exploring!"
