{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noteconnection.local/schemas/agent-workspace-tauri-evidence-manifest.schema.json",
  "title": "Agent Workspace Tauri Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "schema",
    "version",
    "evidenceSetId",
    "strict",
    "sourceIndexPath",
    "artifacts",
    "summary",
    "strictValidation"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "noteconnection.agent-workspace.tauri-evidence-manifest"
    },
    "version": {
      "const": 1
    },
    "evidenceSetId": {
      "type": "string",
      "minLength": 1
    },
    "strict": {
      "type": "boolean"
    },
    "sourceIndexPath": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "exists",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "evidence-index",
              "evidence-summary",
              "release-fragment",
              "rust-report",
              "window-evidence-report",
              "proxy-smoke-report"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "exists": {
            "type": "boolean"
          },
          "sizeBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalArtifactCount",
        "presentArtifactCount",
        "missingArtifactCount"
      ],
      "properties": {
        "totalArtifactCount": {
          "type": "integer"
        },
        "presentArtifactCount": {
          "type": "integer"
        },
        "missingArtifactCount": {
          "type": "integer"
        }
      }
    },
    "strictValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "reasons"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
