      "id": "confirm-throughput-en",
      "split": "evaluation",
      "language": "en",
      "category": "math",
      "query": "Explain average throughput and its equation.",
      "documents": [
        {
          "documentId": "confirm-throughput-en-0",
          "sourcePath": "evaluation-v2/confirm-throughput-en/source-0.md",
          "language": "en",
          "content": "# Average Throughput\nAverage throughput is the number of completed operations divided by the elapsed time.\n\n$$\nQ = \\frac{N}{t}\n$$\n\nHere N is the completed operation count and t is a positive duration."
        }
      ],
      "reference": {
        "facts": [
          {
