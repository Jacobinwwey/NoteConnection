    {
      "id": "eval-replacement-en",
      "split": "evaluation",
      "language": "en",
      "category": "multi_step",
      "query": "How do I perform safe snapshot replacement?",
      "documents": [
        {
          "documentId": "eval-replacement-en-doc-1",
          "sourcePath": "evaluation/eval-replacement-en/source-1.md",
          "language": "en",
          "content": "# Safe Snapshot Replacement\nPerform these steps in order:\n1. Write the new state to a temporary file.\n2. Flush the temporary file contents.\n3. Atomically rename the temporary file over the old snapshot.\n4. Acknowledge the write only after the replacement succeeds.\nA failed replacement must not acknowledge success."
        }
      ],
      "reference": {
        "facts": [
          {
            "id": "fact-1",
            "patterns": [
              "temporary file"
            ]
          },
          {
            "id": "fact-2",
            "patterns": [
              "flush"
            ]
          },
          {
            "id": "fact-3",
            "patterns": [
              "rename"
            ]
          },
          {
            "id": "fact-4",
            "patterns": [
              "acknowledge"
            ]
          }
        ],
        "unsupportedClaims": [
          {
            "id": "unsupported-1",
            "pattern": "acknowledge before replacement"
          }
        ],
        "expectsConflict": false,
        "expectsAbstention": false,
        "orderedSteps": [
          "temporary file",
          "flush",
          "rename",
          "acknowledge"
        ]
      }
    },
