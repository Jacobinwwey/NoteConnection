            "id": "fact-2",
            "patterns": [
              "admission|reject"
            ]
          }
        ],
        "unsupportedClaims": [
          {
            "id": "unsupported-1",
            "pattern": "eliminates all latency"
          }
        ],
        "expectsConflict": false,
        "expectsAbstention": false
      }
    },
