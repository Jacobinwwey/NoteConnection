      "id": "cal-overload-en",
      "split": "calibration",
      "language": "en",
      "category": "causal",
      "query": "Why does unbounded queuing increase latency?",
      "documents": [
        {
          "documentId": "cal-overload-en-doc-1",
          "sourcePath": "evaluation/cal-overload-en/source-1.md",
          "language": "en",
          "content": "# Unbounded Queuing\nUnbounded queuing increases latency because requests wait behind accumulated work. Limiting admission rejects excess work before it consumes queue memory."
        }
      ],
      "reference": {
        "facts": [
          {
            "id": "fact-1",
            "patterns": [
              "wait|waiting"
            ]
          },
